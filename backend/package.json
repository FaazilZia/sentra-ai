{
  "name": "backend-node",
  "version": "2.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:e2e": "IS_E2E_TEST=true ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && rm -rf dist && node scripts/build.js",
    "start": "node dist/src/server.js",
    "start:render": "node dist/src/server.js",
    "seed": "ts-node prisma/seed.ts",
    "seed:enterprise": "ts-node --project tsconfig.json src/scripts/seed-enterprise.ts",
    "seed:demo": "ts-node --project tsconfig.json src/scripts/seed-demo-account.ts",
    "verify:seed": "ts-node --project tsconfig.json src/scripts/verify-seed.ts",
    "reindex": "ts-node --project tsconfig.json src/scripts/reindex-frameworks.ts",
    "validate:db": "ts-node --project tsconfig.json src/scripts/validate-db.ts",
    "migrate:create": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down",
    "test:db:status": "docker compose -f ../docker-compose.test.yml ps",
    "test:unit": "jest --testPathIgnorePatterns='tests/e2e/'",
    "test:e2e": "playwright test",
    "test:e2e:jest": "jest --testPathPatterns='tests/e2e/' --testPathIgnorePatterns='/node_modules/|/dist/|.*\\.spec\\.ts' --runInBand",
    "test:load": "bash tests/load/run.sh",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:ci": "jest --coverage --ci --testPathIgnorePatterns='tests/e2e/'",
    "test": "node --max-old-space-size=4096 ./node_modules/.bin/jest --coverage --testPathIgnorePatterns='tests/e2e/' --runInBand"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
