generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CORE ORGANIZATION & TENANCY
// ============================================================

model organizations {
  id              String   @id @default(uuid())
  name            String
  apiKey          String?  @unique @map("api_key")
  slug            String   @unique
  is_active       Boolean
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  alertEmail      String?  @map("alert_email")
  slackWebhookUrl String?  @map("slack_webhook_url")
  data_region     String   @default("US") @map("data_region")

  // Enterprise fields
  plan           String  @default("free")
  max_users      Int     @default(10)
  max_workspaces Int     @default(3)
  sso_enabled    Boolean @default(false)
  sso_provider   String?
  saml_metadata  Json?
  custom_domain  String? @unique

  // Relations
  ai_agents            ai_agents[]
  api_keys             api_keys[]
  audit_logs           audit_logs[]
  connectors           connectors[]
  drift_alerts         drift_alerts[]
  incidents            incidents[]
  interception_logs    interception_logs[]
  alert_rules          alert_rules[]
  logs                 logs[]
  policies             policies[]
  policy_versions      policy_versions[]
  scan_jobs            scan_jobs[]
  users                users[]
  usage_stats          usage_stats[]
  alerts               alerts[]
  compliance_snapshots compliance_snapshots[]
  compliance_fix_tasks compliance_fix_tasks[]
  outcome_validations  outcome_validations[]
  monitoring_status    monitoring_status[]
  compliance_drift     compliance_drift[]
  workspaces           workspaces[]
  org_settings         org_settings?
  org_invitations      org_invitations[]
  evaluation_runs      evaluation_runs[]
  benchmark_datasets   benchmark_datasets[]
  feature_flag_overrides feature_flag_overrides[]
  platform_events      platform_events[]
  workflow_tasks       workflow_tasks[]
  ai_systems             ai_systems[]
  risk_assessments       risk_assessments[]
  impact_assessments     impact_assessments[]
  controls               controls[]
  control_implementations control_implementations[]
  vendor_ai_tools        vendor_ai_tools[]
  compliance_obligations  compliance_obligations[]
  notifications          notifications[]
  evidence               evidence[]

  @@map("companies")
}

model workspaces {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  description    String?
  is_default     Boolean  @default(false)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization organizations          @relation(fields: [organizationId], references: [id])
  memberships  workspace_memberships[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model workspace_memberships {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   @default("MEMBER")
  created_at  DateTime @default(now())

  workspace workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_memberships")
}

model org_invitations {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           String    @default("VIEWER")
  token          String    @unique
  expires_at     DateTime
  accepted_at    DateTime?
  invited_by     String    @map("invited_by")
  created_at     DateTime  @default(now())

  organization organizations @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([token])
  @@map("org_invitations")
}

model org_settings {
  id                      String   @id @default(uuid())
  organizationId          String   @unique @map("organization_id")
  mfa_required            Boolean  @default(false)
  session_timeout_minutes Int      @default(1440)
  allowed_ip_ranges       Json?
  data_retention_days     Int      @default(90)
  audit_export_enabled    Boolean  @default(true)
  logo_url                String?
  primary_color           String?
  webhook_url             String?
  webhook_events          Json?
  updated_at              DateTime @updatedAt

  organization organizations @relation(fields: [organizationId], references: [id])

  @@map("org_settings")
}

// ============================================================
// USERS
// ============================================================

model users {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  email                 String   @unique
  full_name             String
  employeeId            String?  @unique @map("employee_id")
  password_hash         String?
  role                  String   @default("VIEWER")
  is_active             Boolean
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  email_verified        Boolean  @default(false)
  email_verify_token    String?
  email_verify_expires  DateTime?
  mfa_enabled           Boolean  @default(false)
  mfa_secret            String?
  mfa_recovery_codes    String[]
  password_reset_token  String?
  password_reset_expires DateTime?
  last_login_at         DateTime?
  login_count           Int      @default(0)
  google_id             String?  @unique
  github_id             String?  @unique

  consent_records           consent_records[]
  incidents_resolved        incidents[]               @relation("IncidentResolver")
  incidents_created         incidents[]               @relation("IncidentAuthor")
  refresh_tokens            RefreshToken[]
  requests                  requests[]
  organizations             organizations             @relation(fields: [organizationId], references: [id])
  user_roles                user_roles[]
  login_sessions            login_sessions[]
  workspace_memberships     workspace_memberships[]
  workflow_approvals        workflow_approvals[]
  workflow_tasks_assigned   workflow_tasks[]          @relation("WorkflowTaskAssignee")
  workflow_tasks_created    workflow_tasks[]          @relation("WorkflowTaskCreator")
  audit_logs_authored       audit_logs[]
  ai_systems_owned          ai_systems[]              @relation("OwnerUser")
  notifications             notifications[]
  evidence                  evidence[]

  @@map("users")
}

// ============================================================
// ENTERPRISE RBAC
// ============================================================

model roles {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_roles       user_roles[]
  role_permissions role_permissions[]

  @@map("roles")
}

model permissions {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  created_at  DateTime @default(now())

  role_permissions role_permissions[]

  @@unique([resource, action])
  @@map("permissions")
}

model role_permissions {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  created_at   DateTime @default(now())

  role       roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model user_roles {
  id             String   @id @default(uuid())
  user_id        String
  role_id        String
  organizationId String   @map("organization_id")
  assigned_by    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, organizationId])
  @@map("user_roles")
}

// ============================================================
// SESSIONS & DEVICES
// ============================================================

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  device_id  String?
  ip_address String?
  user_agent String?
  session_id String?

  user users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model login_sessions {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  session_token String    @unique
  device_id     String?
  device_name   String?
  ip_address    String?
  user_agent    String?
  location      String?
  is_active     Boolean   @default(true)
  last_active   DateTime  @default(now())
  created_at    DateTime  @default(now())
  expires_at    DateTime
  revoked_at    DateTime?

  user users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("login_sessions")
}

// ============================================================
// POLICIES & GOVERNANCE (PRESERVED)
// ============================================================

model policies {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  name              String
  description       String
  explanation       String?
  compliance        Json?
  impact            String?
  enabled           Boolean
  priority          Int
  effect            String
  status            String
  rule              Json?           @map("rule")
  current_version   Int
  published_version Int?
  scope             Json
  conditions        Json
  obligations       Json
  isTemplate        Boolean         @default(false)
  category          String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  incidents         incidents[]
  organizations     organizations   @relation(fields: [organizationId], references: [id])
  policy_versions   policy_versions[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("policies")
}

model logs {
  id                String        @id @default(uuid())
  requestId         String?       @map("request_id")
  organizationId    String        @map("organization_id")
  agent             String        @map("agent")
  action            String
  status            String
  risk              String        @map("risk")
  reason            String?
  impact            String?
  latency           Int?          @map("latency")
  timestamp         DateTime      @default(now()) @map("timestamp")
  explanation       String?
  confidence        Float?
  timeline          Json?
  compliance        Json?
  metadata          Json?
  overrideComment   String?       @map("override_comment")
  overriddenBy      String?       @map("overridden_by")
  overrideTimestamp DateTime?     @map("override_timestamp")
  isPendingApproval Boolean       @default(false) @map("is_pending_approval")
  approvedBy        String?       @map("approved_by")
  organizations     organizations @relation(fields: [organizationId], references: [id])

  @@index([organizationId, timestamp])
  @@map("logs")
}

model incidents {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  agent_id         String
  policy_id        String?
  severity         Int
  action           String
  details          String
  prompt_excerpt   String
  response_excerpt String
  event_metadata   Json
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  status           String        @default("unresolved")
  user_id          String?
  resolved_by_id   String?
  resolved_at      DateTime?
  organizations    organizations @relation(fields: [organizationId], references: [id])
  policies         policies?     @relation(fields: [policy_id], references: [id])
  resolved_by      users?        @relation("IncidentResolver", fields: [resolved_by_id], references: [id])
  user             users?        @relation("IncidentAuthor", fields: [user_id], references: [id])

  @@map("incidents")
}

model alert_rules {
  id                  String   @id @default(uuid())
  organizationId      String
  threshold_count     Int
  time_window_minutes Int
  webhook_url         String
  created_at          DateTime @default(now())

  organization organizations @relation(fields: [organizationId], references: [id])
}

model policy_versions {
  id                    String        @id @default(uuid())
  policy_id             String
  organizationId        String        @map("organization_id")
  version               Int
  name                  String
  description           String
  enabled               Boolean
  priority              Int
  effect                String
  status                String
  scope                 Json
  conditions            Json
  obligations           Json
  is_published_snapshot Boolean
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  organizations         organizations @relation(fields: [organizationId], references: [id])
  policies              policies      @relation(fields: [policy_id], references: [id])

  @@unique([policy_id, version])
  @@map("policy_versions")
}

model ai_agents {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  name               String
  model              String
  permissions        Json
  status             String
  metadata           Json?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  organizations      organizations   @relation(fields: [organizationId], references: [id])
  dependencies       ai_dependencies[]
  baselineActions    String[]
  baselineDataScopes String[]
  baselineSampledAt  DateTime?
  riskThreshold      Float           @default(0.3)
  evaluation_runs    evaluation_runs[]

  @@map("ai_agents")
}

model ai_dependencies {
  id          String    @id @default(uuid())
  agentId     String    @map("agent_id")
  targetType  String
  targetName  String
  description String?
  created_at  DateTime  @default(now())
  agent       ai_agents @relation(fields: [agentId], references: [id])

  @@map("ai_dependencies")
}

model drift_alerts {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  agentId           String        @map("agent_id")
  type              String
  severity          String
  description       String
  status            String        @default("open")
  timestamp         DateTime      @default(now())
  organizations     organizations @relation(fields: [organizationId], references: [id])
  driftScore        Float         @default(0.0)
  unexpectedActions String[]
  detectedAt        DateTime      @default(now())
  message           String?

  @@map("drift_alerts")
}

model connectors {
  id                 String        @id @default(uuid())
  organizationId     String        @map("organization_id")
  name               String
  type               String
  config             Json
  status             String
  last_scan_at       String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  daily_cost_total   Float         @default(0)
  daily_scan_count   Int           @default(0)
  estimated_cost     Float         @default(0)
  health_metrics     Json?
  health_score       Int           @default(100)
  last_confidence    Float         @default(0)
  last_scan_reason   Json?
  priority           String        @default("medium")
  scan_policy        Json?
  scope              Json?
  total_api_calls    Int           @default(0)
  total_data_scanned BigInt        @default(0)
  credentials        String?
  organizations      organizations @relation(fields: [organizationId], references: [id])

  @@map("connectors")
}

model scan_jobs {
  id                 String        @id @default(uuid())
  organizationId     String        @map("organization_id")
  phase              String
  progress           Int           @default(0)
  incidents_detected Int           @default(0)
  sources_scanned    Int           @default(0)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  organizations      organizations @relation(fields: [organizationId], references: [id])

  @@map("scan_jobs")
}

model api_keys {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  key_prefix     String
  key_hash       String
  key_type       String
  is_active      Boolean
  last_used_at   DateTime?     @map("last_used_at")
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  organizations  organizations @relation(fields: [organizationId], references: [id])

  @@map("api_keys")
}

model usage_stats {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  date           DateTime      @db.Date
  requests_count Int           @default(0)
  tokens_used    Int           @default(0)
  estimated_cost Float         @default(0)
  organizations  organizations @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@map("usage_stats")
}

// ============================================================
// IMMUTABLE AUDIT INFRASTRUCTURE
// ============================================================

model audit_logs {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  user_id        String
  action         String
  feature_id     String?
  metadata       Json?
  timestamp      DateTime  @default(now())
  prev_hash      String?
  entry_hash     String?
  event_type     String    @default("USER_ACTION")
  severity       String    @default("info")
  resource_type  String?
  resource_id    String?
  ip_address     String?
  user_agent     String?
  session_id     String?
  outcome        String    @default("success")

  organizations organizations @relation(fields: [organizationId], references: [id])
  user          users?        @relation(fields: [user_id], references: [id])

  @@index([organizationId, timestamp])
  @@index([organizationId, event_type])
  @@index([organizationId, resource_type, resource_id])
  @@map("audit_logs")
}

// ============================================================
// COMPLIANCE & WORKFLOW ENGINE
// ============================================================

model compliance_fix_tasks {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  featureId      String           @map("feature_id")
  title          String
  description    String?
  priority       Int
  status         String           @default("pending")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  evidence       evidence_records[]
  organizations  organizations    @relation(fields: [organizationId], references: [id])
  workflow_tasks workflow_tasks[]

  @@map("compliance_fix_tasks")
}

model workflow_tasks {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fix_task_id    String?  @map("fix_task_id")
  title          String
  description    String?
  state          String   @default("DRAFT")
  priority       String   @default("medium")
  due_date       DateTime?
  created_by     String   @map("created_by")
  assigned_to    String?  @map("assigned_to")
  category       String   @default("COMPLIANCE")
  framework      String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization organizations         @relation(fields: [organizationId], references: [id])
  fix_task     compliance_fix_tasks? @relation(fields: [fix_task_id], references: [id])
  creator      users                 @relation("WorkflowTaskCreator", fields: [created_by], references: [id])
  assignee     users?                @relation("WorkflowTaskAssignee", fields: [assigned_to], references: [id])
  approvals    workflow_approvals[]
  state_history workflow_state_history[]
  metadata     Json?                 @map("metadata")

  @@index([organizationId])
  @@index([organizationId, state])
  @@map("workflow_tasks")
}

model workflow_approvals {
  id          String   @id @default(uuid())
  task_id     String   @map("task_id")
  reviewer_id String   @map("reviewer_id")
  decision    String
  comment     String?
  created_at  DateTime @default(now())

  task     workflow_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  reviewer users          @relation(fields: [reviewer_id], references: [id])

  @@map("workflow_approvals")
}

model workflow_state_history {
  id         String   @id @default(uuid())
  task_id    String   @map("task_id")
  from_state String
  to_state   String
  actor_id   String
  comment    String?
  metadata   Json?
  created_at DateTime @default(now())

  task workflow_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("workflow_state_history")
}

model evidence_records {
  id                String               @id @default(uuid())
  taskId            String               @map("task_id")
  type              String
  value             String
  hash              String?
  source_type       String               @default("user")
  verified          Boolean              @default(false)
  validation_status String               @default("pending")
  validated_at      DateTime             @default(now())
  uploaded_at       DateTime             @default(now())
  task              compliance_fix_tasks @relation(fields: [taskId], references: [id])

  @@map("evidence_records")
}

model compliance_snapshots {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  featureId      String         @map("feature_id")
  gdpr_score     Int
  dpdp_score     Int
  hipaa_score    Int
  risk_level     String
  created_at     DateTime       @default(now())
  organizations  organizations? @relation(fields: [organizationId], references: [id])

  @@map("compliance_snapshots")
}

model compliance_drift {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  feature_id       String
  drift_percentage Float
  time_window      String        @default("6h")
  detected_at      DateTime      @default(now())
  severity         String        @default("low")
  organizations    organizations @relation(fields: [organizationId], references: [id])

  @@map("compliance_drift")
}

// ============================================================
// AI EVALUATION FRAMEWORK
// ============================================================

model evaluation_runs {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  agent_id           String?   @map("agent_id")
  dataset_id         String?   @map("dataset_id")
  run_type           String
  status             String    @default("pending")
  governance_score   Float?
  safety_score       Float?
  hallucination_rate Float?
  total_tests        Int       @default(0)
  passed_tests       Int       @default(0)
  failed_tests       Int       @default(0)
  triggered_by       String?
  started_at         DateTime?
  completed_at       DateTime?
  created_at         DateTime  @default(now())
  metadata           Json?

  organization organizations       @relation(fields: [organizationId], references: [id])
  agent        ai_agents?          @relation(fields: [agent_id], references: [id])
  dataset      benchmark_datasets? @relation(fields: [dataset_id], references: [id])
  results      evaluation_results[]

  @@index([organizationId])
  @@map("evaluation_runs")
}

model evaluation_results {
  id         String   @id @default(uuid())
  run_id     String   @map("run_id")
  test_name  String
  test_type  String
  input      String
  expected   String?
  actual     String?
  passed     Boolean
  score      Float    @default(0)
  risk_level String   @default("low")
  details    Json?
  created_at DateTime @default(now())

  run evaluation_runs @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id])
  @@map("evaluation_results")
}

model benchmark_datasets {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  name           String
  description    String?
  category       String
  test_cases     Json
  is_builtin     Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  organization    organizations?  @relation(fields: [organizationId], references: [id])
  evaluation_runs evaluation_runs[]

  @@map("benchmark_datasets")
}

// ============================================================
// ADMIN PLATFORM
// ============================================================

model feature_flags {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  rollout_pct Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  overrides feature_flag_overrides[]

  @@map("feature_flags")
}

model feature_flag_overrides {
  id             String   @id @default(uuid())
  flag_id        String   @map("flag_id")
  organizationId String   @map("organization_id")
  enabled        Boolean
  created_at     DateTime @default(now())

  flag         feature_flags @relation(fields: [flag_id], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [organizationId], references: [id])

  @@unique([flag_id, organizationId])
  @@map("feature_flag_overrides")
}

model platform_events {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  actor_id       String?   @map("actor_id")
  event_type     String
  payload        Json?
  created_at     DateTime  @default(now())

  organization organizations? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([event_type])
  @@map("platform_events")
}

// ============================================================
// EXISTING — PRESERVED UNCHANGED
// ============================================================

model consent_records {
  id             String   @id @default(uuid())
  user_id        String
  action         String
  notice_version String
  hashing_chain  String
  metadata_json  Json
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  users          users    @relation(fields: [user_id], references: [id])
}

model alerts {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  feature_id     String?
  type           String
  message        String
  severity       String         @default("low")
  is_read        Boolean        @default(false)
  created_at     DateTime       @default(now())
  organizations  organizations? @relation(fields: [organizationId], references: [id])

  @@map("alerts")
}

model interception_logs {
  id               String              @id @default(uuid())
  user_id          String
  organizationId   String              @map("organization_id")
  input_text       String
  output_text      String?
  decision         String
  confidence       String              @default("High")
  override_status  String              @default("none")
  reason           String?
  policy_triggered String?
  metadata         Json?
  timestamp        DateTime            @default(now())
  organizations    organizations       @relation(fields: [organizationId], references: [id])
  overrides        guardrail_overrides[]

  @@map("interception_logs")
}

model guardrail_overrides {
  id               String            @id @default(uuid())
  log_id           String            @map("log_id")
  interception_log interception_logs @relation(fields: [log_id], references: [id])
  requested_by     String
  approved_by      String?
  status           String            @default("pending")
  reason           String
  timestamp        DateTime          @default(now())

  @@map("guardrail_overrides")
}

model requests {
  id         String   @id @default(uuid())
  user_id    String
  prompt     String
  response   String
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id])
}

model outcome_validations {
  id                 String        @id @default(uuid())
  organizationId     String        @map("organization_id")
  feature_id         String
  action_id          String?
  previous_score     Float
  new_score          Float
  previous_risk      String
  new_risk           String
  validation_status  String        @default("pending")
  outcome_confidence String        @default("High")
  validated_at       DateTime      @default(now())
  organizations      organizations @relation(fields: [organizationId], references: [id])

  @@map("outcome_validations")
}

model monitoring_status {
  id                  String        @id @default(uuid())
  organizationId      String        @map("organization_id")
  feature_id          String        @unique
  status              String        @default("active")
  last_checked_at     DateTime      @default(now())
  violations_last_24h Int           @default(0)
  stability           String        @default("stable")
  organizations       organizations @relation(fields: [organizationId], references: [id])

  @@map("monitoring_status")
}

// ============================================================
// NEW AI GOVERNANCE MODULES
// ============================================================

model ai_systems {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  model_name     String
  model_version  String
  vendor         String
  use_case       String
  risk_tier      String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  owner_user_id  String?  @map("owner_user_id")
  status         String   @default("ACTIVE") // ACTIVE | DEPRECATED | UNDER_REVIEW
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization       organizations        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              users?               @relation("OwnerUser", fields: [owner_user_id], references: [id])
  model_card         model_cards?
  risk_assessments   risk_assessments[]
  impact_assessments impact_assessments[]

  @@index([organizationId])
  @@map("ai_systems")
}

model risk_assessments {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ai_system_id   String   @map("ai_system_id")
  score          Int      @default(0)
  risk_level     String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status         String   @default("DRAFT") // DRAFT | SUBMITTED
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ai_system    ai_systems    @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)
  answers      risk_assessment_answers[]

  @@index([organizationId])
  @@map("risk_assessments")
}

model risk_assessment_answers {
  id                 String   @id @default(uuid())
  risk_assessment_id String   @map("risk_assessment_id")
  question_key       String
  answer             String
  score              Int      @default(0)

  risk_assessment risk_assessments @relation(fields: [risk_assessment_id], references: [id], onDelete: Cascade)

  @@unique([risk_assessment_id, question_key])
  @@map("risk_assessment_answers")
}

model impact_assessments {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  ai_system_id   String    @map("ai_system_id")
  type           String    // DPIA | AIA
  status         String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | REJECTED
  form_data      Json
  submitted_by   String?
  reviewed_by    String?
  approved_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  organization organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ai_system    ai_systems    @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("impact_assessments")
}

model controls {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  framework      String   // EU_AI_ACT | NIST_AI_RMF | ISO_42001 | GDPR
  control_id     String   // e.g. EU-AIA-9
  title          String
  description    String
  category       String

  organization           organizations          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control_implementations control_implementations[]
  compliance_obligations  compliance_obligations[]

  @@unique([organizationId, framework, control_id])
  @@map("controls")
}

model control_implementations {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  control_id     String    @map("control_id")
  status         String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | IMPLEMENTED | NOT_APPLICABLE
  evidence       Json      @default("[]")
  notes          String?
  owner_user_id  String?   @map("owner_user_id")
  due_date       DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  organization organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control      controls      @relation(fields: [control_id], references: [id], onDelete: Cascade)

  @@unique([organizationId, control_id])
  @@map("control_implementations")
}

model vendor_ai_tools {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  vendor_name      String
  tool_name        String
  tool_category    String    // LLM | AGENT | EMBEDDING | OTHER
  data_shared      Json
  risk_level       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  review_status    String    @default("PENDING") // PENDING | APPROVED | FLAGGED
  reviewer_id      String?   @map("reviewer_id")
  last_reviewed_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organization organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("vendor_ai_tools")
}

model model_cards {
  id                        String   @id @default(uuid())
  ai_system_id              String   @unique @map("ai_system_id")
  intended_use              String
  out_of_scope_use          String
  training_data_description String
  known_limitations         String
  bias_considerations       String
  performance_metrics       Json
  last_updated_by           String?  @map("last_updated_by")
  version                   String   @default("1.0.0")
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  ai_system ai_systems @relation(fields: [ai_system_id], references: [id], onDelete: Cascade)

  @@map("model_cards")
}

model compliance_obligations {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  framework      String    // EU_AI_ACT | NIST_AI_RMF
  article_or_task String    // e.g. "EU AI Act Art. 13 — Transparency"
  description    String
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | MET | NOT_APPLICABLE
  owner_user_id  String?   @map("owner_user_id")
  deadline       DateTime?
  linked_control_id String? @map("linked_control_id")

  organization organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control      controls?     @relation(fields: [linked_control_id], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("compliance_obligations")
}

// ============================================================
// WAVE 1 MODULES: NOTIFICATIONS & EVIDENCE
// ============================================================

enum NotificationType {
  alert
  policy
  risk
  incident
  workflow
  drift
}

model notifications {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  orgId      String           @map("organization_id")
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  user         users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@map("notifications")
}

enum EvidenceType {
  risk
  policy
  compliance
  incident
  guardrail
}

model evidence {
  id          String       @id @default(uuid())
  orgId       String       @map("organization_id")
  uploadedBy  String       @map("uploaded_by")
  title       String
  description String?
  fileUrl     String       @map("file_url")
  fileName    String       @map("file_name")
  fileSize    Int          @map("file_size")
  mimeType    String       @map("mime_type")
  entityType  EvidenceType @map("entity_type")
  entityId    String?      @map("entity_id")
  tags        String[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organization organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([uploadedBy])
  @@map("evidence")
}

