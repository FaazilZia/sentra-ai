  mapping_strength      Float    @default(1.0) @map("mapping_strength")
  created_at            DateTime @default(now()) @map("created_at")

  @@index([source_framework, source_control_code])
  @@index([target_framework, target_control_code])
  @@map("framework_control_mappings")
}

model governance_evidence {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  framework           String    // GDPR | EU_AI_ACT | NIST_AI_RMF | ISO_42001
  control_code        String    @map("control_code")
  framework_version   String    @default("1.0.0") @map("framework_version")
  
  evidence_type       String    // TELEMETRY | MANUAL_UPLOAD | RUNTIME_ENFORCEMENT
  source_type         String    // MANUAL | AUTOMATED | MONITORED | ENFORCED | REPORTED
  
  source_system       String    @map("source_system") // e.g. interceptor, drift_monitor
  source_reference    String    @map("source_reference") // entity ID references
  
  confidence_score    Float     @default(0.5) @map("confidence_score")
  freshness_score     Float     @default(1.0) @map("freshness_score")
  
  metadata            Json      @default("{}")
  created_at          DateTime  @default(now()) @map("created_at")
  archived_at         DateTime? @map("archived_at")
  expires_at          DateTime? @map("expires_at")
  retention_class     String    @default("TELEMETRY") @map("retention_class")

  // Event Deduplication & Dense Aggregation
  event_hash          String?   @map("event_hash")
  deduplication_key   String?   @map("deduplication_key")
  aggregate_count     Int       @default(1) @map("aggregate_count")
  first_seen_at       DateTime  @default(now()) @map("first_seen_at")
  last_seen_at        DateTime  @default(now()) @map("last_seen_at")

  // Lineage / Relationship Graph
  parent_evidence_id  String?   @map("parent_evidence_id")
  related_entity_type String?   @map("related_entity_type")
  related_entity_id   String?   @map("related_entity_id")

  // Cryptographic Assurance / Legal Audit Readiness
  evidence_signature  String?   @map("evidence_signature")
  signing_key_version String    @default("v1") @map("signing_key_version")
  checksum            String?   @map("checksum")
  immutable           Boolean   @default(false) @map("immutable")

  organization        organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([framework])
  @@index([control_code])
  @@index([event_hash])
  @@index([deduplication_key])
  @@map("governance_evidence")
}

