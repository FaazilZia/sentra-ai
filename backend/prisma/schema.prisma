model governance_incidents {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  incident_type         String    @map("incident_type")
  severity              String    
  related_frameworks    String[]  @map("related_frameworks")
  related_controls      String[]  @map("related_controls")
  title                 String
  description           String
  source_event_id       String?   @map("source_event_id")
  source_system         String    @map("source_system")
