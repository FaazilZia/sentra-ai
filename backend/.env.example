# ============================================================
# Sentra AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development  # Options: development | production | test

# --- Database (PostgreSQL) ---
# Supabase pooler URL for Render deployments:
# Format: postgresql://<user>:<password>@<host>:<port>/postgres
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# --- Security (REQUIRED) ---
# Generate with: openssl rand -hex 32 (minimum 32 characters)
JWT_SECRET="replace-with-a-256-bit-random-secret"
REFRESH_SECRET="replace-with-another-256-bit-random-secret"
ENCRYPTION_KEY="replace-with-at-least-32-character-key"

# --- Token Expiry ---
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slashes)
FRONTEND_URL="https://sentra-ai.vercel.app,http://localhost:5173"

# --- AI Services (Optional — pattern-based fallback if not set) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Redis (Required in production for distributed rate limiting + BullMQ jobs) ---
# Without this: rate limiting = in-memory, caching = disabled, background jobs = disabled
REDIS_URL=redis://localhost:6379

# --- Seed Credentials (Optional — auto-generated if not set) ---
# SEED_ADMIN_PASSWORD=your-admin-password

# --- Google OAuth (Optional) ---
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Observability (Optional) ---
# SENTRY_DSN=your-sentry-dsn

# --- Alerting (Optional) ---
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=your-postmark-server-token
# SMTP_PASS=your-postmark-server-token
# SMTP_FROM="Sentra AI Alerts" <alerts@sentra.ai>
