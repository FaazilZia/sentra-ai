# ============================================================
# Sentra AI — Backend Node.js Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=production  # Options: development | production | test

# --- Database (Supabase/PostgreSQL) ---
# Your Supabase connection string (use the "Session Mode" pooler URL for Render)
# Format: postgresql://<user>:<password>@<host>:<port>/postgres
DATABASE_URL="postgresql://postgres.[project-ref]:[your-password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
DATABASE_URL_TEST="postgresql://postgres:[your-password]@localhost:5432/sentra_test"
DIRECT_URL="postgresql://postgres:[your-password]@db.[project-ref].supabase.co:5432/postgres"

# --- Database Connection Pool (Item 14) ---
# Pool is sized in src/config/db.ts. Tune these env vars to override:
#   max connections  = DB_POOL_MAX (default: 20)
#     Formula: min(DB_MAX_CONNECTIONS / NUM_INSTANCES, 25)
#     e.g. Supabase Free (25 total connections) / 2 Render instances = 12 each
#   idle timeout     = DB_POOL_IDLE_TIMEOUT_MS   (default: 30000 = 30s)
#   connect timeout  = DB_POOL_CONNECT_TIMEOUT_MS (default: 10000 = 10s)
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECT_TIMEOUT_MS=10000

# --- JWT Authentication ---
# Use at least 32-character random strings. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-256-bit-random-secret"
REFRESH_SECRET="replace-with-another-256-bit-random-secret"

# --- Google OAuth ---
# Get these from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# --- Supabase Client ---
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
# --- Token Expiry ---
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slashes)
FRONTEND_URL="https://sentra-ai-tau.vercel.app,https://sentra-ai.vercel.app,http://localhost:5173"

# --- AI Services ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key-here


# --- Organization Scoping ---
# [DEPRECATED] Default organization for demo/dev only. 
# In production, users must have a uniquely provisioned organizationId.
DEFAULT_ORGANIZATION_ID="00000000-0000-0000-0000-000000000001"

# --- Redis (Required in production for rate limiting + background jobs) ---
# Without this, rate limiting falls back to in-memory (not safe for multi-instance deployments)
# and all AI action logs are written synchronously (higher latency per request)
REDIS_URL=redis://localhost:6379

# --- Feature Flags (Optional) ---
# ENABLE_API_KEY_AUTH=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Alerting (Email / Postmark Integration) ---
# NOTE: Configure SMTP_HOST, SMTP_USER, and SMTP_PASS (e.g. using Postmark SMTP) so invitation emails actually send.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your-postmark-server-token
SMTP_PASS=your-postmark-server-token
SMTP_FROM="Sentra AI Alerts" <alerts@sentra.ai>

# --- Security & Privacy ---
# 32-character hex key for encrypting sensitive connector credentials
ENCRYPTION_KEY="your-encryption-key-here"
# Salt used for data masking/hashing to prevent rainbow table attacks
MASKING_SALT="your-masking-salt-here"
# JSON map of versioned signing keys used to HMAC-sign compliance evidence records (tamper-evident audit trail).
# Generate with: openssl rand -hex 32
# Format: {"v1": "your-generated-key"}
GOVERNANCE_SIGNING_KEYS='{"v1": "your-generated-key-here"}'
# SCIM 2.0 provisioning token used by external IdPs for user synchronization
SCIM_BEARER_TOKEN="your-scim-bearer-token-here"
SCIM_BEARER_TOKEN_PLAINTEXT_NEVER_STORED=true

# --- Monitoring & Observability ---
# Sentry DSN for error tracking in production
SENTRY_DSN=""
# Logging level (debug | info | warn | error)
LOG_LEVEL=info
# REQUIRED IN PRODUCTION: Bearer token to protect Prometheus /api/v1/metrics endpoint
METRICS_SECRET_TOKEN="your-metrics-secret-token-here"

# --- Frontend Sync ---
# Used by backend to toggle demo mode behavior (e.g. skipping auth checks)
VITE_DEMO_MODE=false

# --- E2E Testing ---
# Password used for creating test organizations/accounts in E2E tests
TEST_PASSWORD="your-test-password-placeholder-here"

