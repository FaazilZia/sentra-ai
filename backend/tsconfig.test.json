{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "isolatedModules": true,
    "composite": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/__mocks__/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}