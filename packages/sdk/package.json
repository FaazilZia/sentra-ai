{
  "name": "@sentra-ai/sdk",
  "version": "1.1.0",
  "description": "Enterprise-grade SDK for real-time AI governance and runtime security.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --experimental-transform-types --no-warnings --test test/*.test.ts",
    "prepublishOnly": "npm run build && test -d dist || (echo 'Error: dist/ directory not found' && exit 1)"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "security",
    "governance",
    "interceptor",
    "runtime",
    "sentra",
    "sentraa"
  ],
  "author": "Sentra AI Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
