{
  "name": "@sentra-ai/sdk",
  "version": "1.1.0",
  "description": "Enterprise-grade SDK for real-time AI governance and runtime security.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --experimental-transform-types --no-warnings --test test/*.test.ts",
    "prepublishOnly": "npm run build && test -d dist || (echo 'Error: dist/ directory not found' && exit 1)"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "security",
    "governance",
    "interceptor",
    "runtime",
    "sentra",
    "sentraa"
  ],
  "author": "Sentra AI Team",
  "license": "MIT",
  "peerDependencies": {
    "@google/genai": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1158.0",
    "@google/genai": "^2.31.0",
    "typescript": "^5.0.0"
  }
}
