# ============================================================
# Sentra AI — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- API Configuration ---
# The backend API base URL. Automatically normalizes to /api/v1.
# Local:  http://localhost:3000
# Render: https://sentra-backend.onrender.com
VITE_API_BASE_URL="http://localhost:3000"

# --- Google OAuth (Optional) ---
# Required only if Google Sign-In is enabled.
# VITE_GOOGLE_CLIENT_ID=""

# --- Feature Flags ---
# Set to 'true' to bypass authentication for development (NOT for production)
VITE_BYPASS_AUTH="false"

# Set to 'true' ONLY for sales demos — never in production
VITE_DEMO_MODE="false"
